{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hospital-management-qcas.onrender.com/api/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://hospital-management-qcas.onrender.com/storage/:path*"
    },
    {
      "source": "/((?!api(?:/|$)|storage(?:/|$)|assets(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ]
}
