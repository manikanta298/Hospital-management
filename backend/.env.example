PORT=8000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/icthospital
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_LIFETIME_MINUTES=120
# Set to Yes to require an SMS verification code after login (needs ICTCore or an SMS gateway configured)
OTP=No
TELEMED_BASE_URL=https://meet.jit.si
TELEMED_ROOM_PREFIX=icthospital
# Origin allowed to call the API in development (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Optional: CA file for verified TLS to a hosted PostgreSQL server.
# DATABASE_CA_CERT_PATH=/etc/secrets/ca.pem
